# Copy to .env and use absolute host paths. Never commit the real .env file.
REX_SOURCE_DIR=.
REX_DATA_DIR=./data/KuaiRand-Pure/data
REX_RUNS_DIR=./runs
REX_WORKER_IMAGE=rex:local

# In production, pin the locally present image by repo digest or image ID.
# Example: sha256:0123456789abcdef...
REX_EXPECTED_IMAGE_DIGEST=

# Optional local-CLI authentication. These directories are mounted read-only
# into the trusted controller only and are never mounted into workers.
# macOS/Linux examples: /Users/me/.codex and /Users/me/.claude
# Windows examples: C:/Users/me/.codex and C:/Users/me/.claude
REX_CODEX_HOME=
REX_CLAUDE_HOME=

# API mode is optional. Leave these empty when using fixed, Codex CLI, or
# Claude CLI modes. Never put a real key in this example file.
OPENAI_API_KEY=
OPENAI_MODEL=

# Durable paid-API ceilings; configs may impose stricter limits.
REX_MAX_API_CALLS=50
REX_MAX_INPUT_TOKENS=1000000
REX_MAX_OUTPUT_TOKENS=200000
REX_MAX_API_COST_USD=50

# Bounded worker defaults. The controller may lower these per request.
REX_WORKER_CPUS=1.0
REX_WORKER_MEMORY_LIMIT=2g
REX_WORKER_PIDS_LIMIT=128
